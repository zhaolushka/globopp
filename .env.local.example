# Supabase (Settings -> API в панели Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram (получить у @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_BOT_USERNAME=your_bot_username

# Пароль для админки (придумай сам, любая строка)
ADMIN_PASSWORD=change-me

# Секрет для крон-задачи (Vercel сам подставит его в заголовок)
CRON_SECRET=change-me-too-random-string
